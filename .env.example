# Variabili d'ambiente — copia questo file in .env e compila i valori

# TOKEN del bot (da @BotFather su Telegram) — OBBLIGATORIO
BOT_TOKEN=inserisci_qui_il_token

# ID numerico del gruppo (numero negativo, es. -1001234567890)
# Per trovarlo: aggiungi @userinfobot al gruppo e scrivi /start
GROUP_ID=-1001456564882

# ID Telegram degli amministratori, separati da virgola
# Per trovare il tuo ID: scrivi a @userinfobot
ADMIN_IDS=21773014

# Username dell'admin principale (senza @)
ADMIN_USERNAME=marcogiuridio

# Rate limiting
RATE_LIMIT_HOURS=6
MAX_POSTS_PER_DAY=2

# Percorso database SQLite
DB_PATH=bot_data.db
